@startuml
actor Usuario
participant "Sistema" as S
participant "Base de Datos" as BD

Usuario -> S: Selecciona "Mis recorridos guardados"
S -> BD: Recupera recorridos guardados del usuario
BD --> S: Retorna lista de recorridos
alt hay recorridos
  S -> Usuario: Muestra lista de recorridos
else no hay
  S -> Usuario: Muestra mensaje "No hay recorridos guardados"
end
@enduml