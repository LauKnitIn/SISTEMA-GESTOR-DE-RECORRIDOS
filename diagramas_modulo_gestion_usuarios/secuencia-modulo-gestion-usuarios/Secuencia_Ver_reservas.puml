@startuml
actor Usuario
participant "Sistema" as S
participant "Base de Datos" as BD

Usuario -> S: Selecciona "Mis reservas"
S -> BD: Recupera reservas del usuario
BD --> S: Retorna lista de reservas
alt hay reservas
  S -> Usuario: Muestra lista de reservas
else no hay reservas
  S -> Usuario: Muestra mensaje "No tiene reservas"
end
@enduml