@startuml
|Usuario|
start
:En pantalla de inicio sesión, hace clic en "¿Olvidó su contraseña?";

|Sistema|
:Muestra modal con campo de correo;

repeat

|Usuario|
:Ingresa correo;
:Hace clic en "Enviar código";

|Sistema|
:Verifica existencia del correo en BD;

|Base de Datos|
:Busca correo;
:Retorna resultado;

|Sistema|
if (¿Correo registrado?) then (no)

:Muestra error "Correo no registrado";

|Usuario|
:Corrige correo;

else (sí)

|Sistema|
:Envía código de verificación al correo;
:Muestra modal para ingreso de código;

|Usuario|
:Ingresa código;
:Hace clic en "Ingresar";

|Sistema|
:Valida código;

if (¿Código válido?) then (no)

:Muestra error "Código inválido";
stop

else (sí)

|Sistema|
:Redirige a pantalla "Cambiar contraseña";

repeat

|Usuario|
:Ingresa nueva contraseña y confirmación;
:Hace clic en "Actualizar";

|Sistema|
:Valida política de contraseña;

if (¿Validación ok?) then (no)

:Muestra error específico;

|Usuario|
:Corrige datos;

else (sí)

|Sistema|
:Actualiza contraseña en BD;

|Base de Datos|
:Almacena nueva contraseña;
:Confirma;

|Sistema|
:Muestra mensaje "Operación exitosa";
:Redirige a pantalla de perfil;

stop

endif

repeat while (Contraseña inválida) is (sí)

endif
endif

repeat while (Correo incorrecto) is (sí)

@enduml