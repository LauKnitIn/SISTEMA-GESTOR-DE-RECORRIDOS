@startuml
actor Usuario
participant "Sistema" as S
participant "Base de Datos" as BD

Usuario -> S: Desde perfil, hace clic en "Cambiar contraseña"
S -> Usuario: Redirige a pantalla "Cambiar contraseña"

loop while contraseña no válida
  Usuario -> S: Ingresa nueva contraseña
  Usuario -> S: Ingresa confirmación
  Usuario -> S: Hace clic en "Actualizar contraseña"
  
  S -> S: Valida política (mínimo 8 caracteres)
  
  alt validación falla
    S -> Usuario: Muestra error específico (longitud o no coinciden)
  else validación ok
    S -> BD: Actualiza la contraseña
    BD --> S: Confirmación
    S -> Usuario: Muestra mensaje "Operación exitosa"
    S -> Usuario: Redirige a pantalla de perfil
    break
  end
end
@enduml