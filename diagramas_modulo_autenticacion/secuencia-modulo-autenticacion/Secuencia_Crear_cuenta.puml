@startuml
actor "Usuario" as user
participant "Sistema" as system
participant "Base de Datos" as db

user -> system: Accede a pantalla de inicio, clic en botón usuario y selecciona "Iniciar sesión"
system -> user: Muestra pantalla de registro e inicio de sesión

loop while no registrado
  user -> system: Ingresa nombre completo
  user -> system: Ingresa correo electrónico
  user -> system: Ingresa celular
  user -> system: Ingresa documento
  user -> system: Ingresa contraseña
  user -> system: Ingresa confirmar contraseña
  user -> system: Hace clic en "Registrarse"
  
  system -> system: Valida campos obligatorios y formatos básicos
  
  system -> db: Consulta si el correo ya existe
  db --> system: Retorna resultado (existe/no existe)
  
  alt Correo ya existe
    system -> user: Muestra error "El correo electrónico ya está"
  else Datos inválidos (formato, contraseñas, etc.)
    system -> user: Muestra errores específicos
  else Campos válidos y email único
    system -> db: Almacena los datos del nuevo usuario
    db --> system: Confirma almacenamiento
    system -> user: Muestra mensaje "Cuenta creada con éxito"
    system -> user: Redirige a pantalla de Perfil de usuario
    break
  end
end
@enduml