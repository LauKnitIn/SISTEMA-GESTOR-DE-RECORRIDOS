@startuml
actor Usuario
participant "Sistema" as S
participant "Base de Datos" as BD

Usuario -> S: 1. Desde pantalla de inicio, clic en ícono usuario y selecciona "Iniciar sesión"
S -> Usuario: 2. Muestra formulario de ingreso

loop while no autenticado
  Usuario -> S: 3. Ingresa correo
  Usuario -> S: 4. Ingresa contraseña
  Usuario -> S: 5. Hace clic en "Iniciar sesión"
  
  S -> S: 6. Valida campos no vacíos
  alt campos vacíos
    S -> Usuario: 7. Muestra error de campos obligatorios
  else campos completos
    S -> BD: 8. Busca usuario con ese correo
    BD --> S: 9. Retorna resultado (usuario o null)
    alt correo no existe
      S -> Usuario: 10. Muestra "El correo ingresado no está registrado"
    else correo existe
      S -> S: 11. Verifica contraseña
      alt contraseña incorrecta
        S -> Usuario: 12. Muestra "Contraseña incorrecta. Vuelva a intentarlo"
      else contraseña correcta
        S -> S: 13. Establece sesión
        S -> Usuario: 14. Redirige a pantalla de recorridos turísticos
        break
      end
    end
  end
  Usuario -> Usuario: 15. Corrige datos según error
end
@enduml
