@startuml
actor "Usuario" as user
participant "Sistema" as system
participant "Base de Datos" as db

user -> system: 1. Accede a pantalla de inicio, clic en botón usuario y selecciona "Iniciar sesión"
system -> user: 2. Muestra pantalla de registro e inicio de sesión

loop while no registrado
  user -> system: 3. Ingresa nombre completo
  user -> system: 4. Ingresa correo electrónico
  user -> system: 5. Ingresa celular
  user -> system: 6. Ingresa documento
  user -> system: 7. Ingresa contraseña
  user -> system: 8. Ingresa confirmar contraseña
  user -> system: 9. Hace clic en "Registrarse"
  
  system -> system: 10. Valida campos obligatorios y formatos básicos
  
  system -> db: 11. Consulta si el correo ya existe
  db --> system: 12. Retorna resultado (existe/no existe)
  
  alt Correo ya existe
    system -> user: 13. Muestra error "El correo electrónico ya existe"
  else Datos inválidos (formato, contraseñas, etc.)
    system -> user: 14. Muestra errores específicos
  else Campos válidos y email único
    system -> db: 15. Almacena los datos del nuevo usuario
    db --> system: 16. Confirma almacenamiento
    system -> user: 17. Muestra mensaje "Cuenta creada con éxito"
    system -> user: 18. Redirige a pantalla de Perfil de usuario
    break
  end
end
@enduml