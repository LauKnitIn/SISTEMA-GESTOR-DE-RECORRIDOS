@startuml
actor Usuario
participant "Sistema" as S
participant "Base de Datos" as BD

Usuario -> S: En pantalla de inicio sesión, hace clic en "¿Olvidó su contraseña?"
S -> Usuario: Muestra modal con campo de correo

loop while correo no válido
  Usuario -> S: Ingresa correo y hace clic en "Enviar código"
  S -> BD: Verifica si el correo existe
  BD --> S: Retorna resultado
  alt correo no registrado
    S -> Usuario: Muestra error "Correo no registrado"
  else correo existe
    break
  end
end

S -> S: Envía código de verificación al correo (simulado)
S -> Usuario: Muestra modal para ingreso de código

Usuario -> S: Ingresa código y hace clic en "Ingresar"
S -> S: Valida el código
alt código inválido
  S -> Usuario: Muestra error "Código inválido"
  S -> Usuario: Redirige a pantalla de inicio de sesión
else código válido
  S -> Usuario: Redirige a pantalla "Cambiar contraseña"
  loop while contraseña no válida
    Usuario -> S: Ingresa nueva contraseña y confirmación, clic "Actualizar"
    S -> S: Valida política (mínimo 8 caracteres y coincidencia)
    alt validación falla
      S -> Usuario: Muestra error correspondiente
    else validación ok
      break
    end
  end
  S -> BD: Actualiza la contraseña
  BD --> S: Confirmación
  S -> Usuario: Muestra mensaje "Operación exitosa"
  S -> Usuario: Redirige a pantalla de perfil
end
@enduml